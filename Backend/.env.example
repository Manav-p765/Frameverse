# ─── Frameverse Backend Environment Variables ────────────────────────────────
# Copy this file to .env and fill in the values.

# ─── Database ────────────────────────────────────────────────────────────────
MONGO_URL=mongodb+srv://user:password@cluster.mongodb.net/frameverse
PORT=8080

# ─── Authentication ──────────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here

# ─── Firebase Admin SDK ──────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── Cloudinary (Image uploads) ──────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Google reCAPTCHA ────────────────────────────────────────────────────────
RECAPTCHA_PROJECT_ID=your-project-id
RECAPTCHA_SECRET_KEY=your_secret_key
RECAPTCHA_SITE_KEY=your_site_key

# ─── Gemini AI ───────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key

# ─── Email (SMTP via Gmail) ──────────────────────────────────────────────────
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://default:password@host:port

# ─── URLs ────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8080

# ─── Web Push (VAPID) ───────────────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC=your_vapid_public_key
VAPID_PRIVATE=your_vapid_private_key
VAPID_EMAIL=mailto:your_email@example.com

# ─── GitHub (AutoPost — private repo access) ────────────────────────────────
# Fine-grained PAT with read-only repo access: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_personal_access_token
